generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(cuid())
  googleId    String    @unique
  email       String    @unique
  name        String
  picture     String?
  role        Role      @default(USER)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  projects    Project[]

  @@index([role])
  @@index([isActive])
}

enum Role {
  ADMIN
  HELPER
  USER
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
}

enum DownloadType {
  BLEND
  TEXTURE
  HDRI
  MATERIAL
  ADDON
  DOCUMENTATION
  LICENSE
  OTHER
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Technology {
  id      String    @id @default(cuid())
  name    String    @unique
  icon    String?
  website String?
  projects Project[]
}

model Project {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  shortDescription String?
  description      String?
  featured         Boolean      @default(false)
  published        Boolean      @default(false)
  publishedAt      DateTime?
  visibility       Visibility   @default(PUBLIC)
  thumbnailKey     String?
  sortOrder        Int          @default(0)

  category         Category?    @relation(fields: [categoryId], references: [id])
  categoryId       String?

  creator          User         @relation(fields: [createdBy], references: [id])
  createdBy        String

  technologies     Technology[]
  media            ProjectMedia[]
  downloads        ProjectDownload[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([categoryId])
  @@index([createdBy])
  @@index([published])
  @@index([featured])
  @@index([visibility])
  @@index([sortOrder])
}

model ProjectMedia {
  id        String    @id @default(cuid())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  type      MediaType
  storageKey String
  fileName  String
  title     String?
  altText   String?
  order     Int       @default(0)

  createdAt DateTime  @default(now())

  @@index([projectId])
}

model ProjectDownload {
  id            String       @id @default(cuid())
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String

  type          DownloadType
  label         String
  storageKey    String
  fileSizeBytes Int?
  downloadCount Int          @default(0)

  createdAt     DateTime     @default(now())

  @@index([projectId])
}